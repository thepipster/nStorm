{
  "name": "nstorm",
  "version": "3.0.0",
  "description": "Node.js real-time processing engine, based on Twitter's Storm",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "directories": {
    "example": "example",
    "src": "src"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx example/simple-example.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thepipster/nStorm.git"
  },
  "author": "Mike Pritchard",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thepipster/nStorm/issues"
  },
  "homepage": "https://github.com/thepipster/nStorm#readme",
  "dependencies": {
    "async": "^3.2.5",
    "bullmq": "^5.1.0",
    "callsite": "^1.0.0",
    "chalk": "^4.1.2",
    "ioredis": "^5.3.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/async": "^3.2.24",
    "@types/callsite": "^1.0.34",
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
