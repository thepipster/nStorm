{
    "name": "nstorm",
    "version": "5.1.0",
    "description": "Node.js real-time processing engine, based on Twitter's Storm",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "directories": {
        "example": "example"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "prepublishOnly": "npm run check && npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc -p tsconfig.check.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
        "example": "tsx example/simple-example.ts",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thepipster/nStorm.git"
    },
    "author": "Mike Pritchard",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/thepipster/nStorm/issues"
    },
    "homepage": "https://thepipster.github.io/nStorm/",
    "dependencies": {
        "async": "^3.2.5",
        "bullmq": "^5.76.2",
        "callsite": "^1.0.0",
        "chalk": "^4.1.2",
        "ioredis": "^5.3.2",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/async": "^3.2.24",
        "@types/callsite": "^1.0.34",
        "@types/node": "^20.11.0",
        "eslint": "^10.15.0",
        "prettier": "^3.10.1",
        "tsx": "^4.21.0",
        "typescript": "^5.3.3",
        "typescript-eslint": "^8.73.0",
        "vitepress": "2.0.0-alpha.21",
        "vitest": "^4.0.18"
    },
    "engines": {
        "node": ">=20"
    }
}
